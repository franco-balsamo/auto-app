EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Opcional — sin esto, Sentry no inicializa (no bloquea el arranque)
EXPO_PUBLIC_SENTRY_DSN=

# Opcional — sin esto, sacar foto de factura sigue andando pero sin
# autocompletar monto/fecha (OCR vía Google Cloud Vision API)
EXPO_PUBLIC_GOOGLE_VISION_API_KEY=

# Requerido pa build Android — key de Google Maps SDK, restringida por
# package name (com.balsamote96.autoapp) + SHA-1 en Google Cloud Console
GOOGLE_MAPS_API_KEY=
